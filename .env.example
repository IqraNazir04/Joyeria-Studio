# Postgres connection string.
# Local dev: postgresql://localhost:5432/joyeria_studio
# Production (Neon): get this from your Neon project dashboard.
DATABASE_URL="postgresql://localhost:5432/joyeria_studio"

# Public site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number that receives "Order on WhatsApp" and order-confirmation
# messages. Digits only, with country code, no leading + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Optional: a Slack/Discord/Telegram incoming-webhook URL. When set, every
# new order posts a one-line summary there so it's never missed.
ORDER_NOTIFY_WEBHOOK_URL=""

# Orders with a subtotal at or above this (whole PKR) get free delivery.
# Enforced server-side in /api/checkout — the banner and checkout summary
# just reflect it, they don't decide it.
FREE_DELIVERY_THRESHOLD="3000"

# Orders with a total at or above this (whole PKR) can't be paid cash on
# delivery — the customer must prepay via bank transfer, JazzCash or
# Easypaisa instead. Enforced server-side in /api/checkout on the re-priced
# total; the checkout form just disables the COD option to match.
ADVANCE_PAYMENT_THRESHOLD="5000"

# Shown in the footer's Follow column and used for the homepage Instagram
# section's outbound link. Optional — the block is skipped without it.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# Powers the customer-support chat widget (bottom-right, storefront only).
# Get a key at https://console.anthropic.com — without it, the widget shows
# a "message us on WhatsApp instead" fallback rather than failing hard.
ANTHROPIC_API_KEY=""

# Admin auth (NextAuth v5). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""

# Seed-only: creates/updates the first AdminUser when you run `npm run db:seed`.
# Change the password after first login — there's no in-app "change password" yet.
ADMIN_EMAIL="admin@joyeriastudio.com"
ADMIN_PASSWORD="changeme123"

# Optional: rate limiting on checkout/chat/track-order is in-memory by
# default, which under-counts once you're running more than one serverless
# instance (e.g. Vercel). Set both to switch to a shared Redis-backed count —
# free tier at https://upstash.com is enough for this. Leave unset for local
# dev; the in-memory fallback keeps working either way.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Powers product image uploads in the admin panel (Products > Images).
# Get these from your Cloudinary dashboard at https://cloudinary.com/console
# — free tier is enough. Without them set, the upload button returns a clear
# error and admins can still paste an image URL directly instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Added in later phases (payments) ---
# RESEND_API_KEY=""
